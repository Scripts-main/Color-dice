-- =======================================================
-- LÓGICA Y ANIMACIÓN DE DADOS
-- =======================================================

local isRolling = false

rollBtn.MouseButton1Click:Connect(function()
	if isRolling then return end
	isRolling = true
	
	-- Pre-calcular los colores finales de los 4 dados
	local finalResults = {}
	for i = 1, #diceSlots do
		table.insert(finalResults, colorKeys[math.random(1, #colorKeys)])
	end
	
	-- PASO 1: Animación "a lo loco" durante 2 segundos
	local startTime = os.clock()
	while os.clock() - startTime < 2 do
		for _, slotData in ipairs(diceSlots) do
			local randomName = colorKeys[math.random(1, #colorKeys)]
			slotData.Frame.BackgroundColor3 = diceColors[randomName]
			slotData.Label.Text = randomName
		end
		task.wait(0.06)
	end
	
	-- PASO 2: Caen 1 por 1 revelando el resultado final con rebote
	for i, slotData in ipairs(diceSlots) do
		local finalColorName = finalResults[i]
		
		slotData.Frame.Size = UDim2.new(0, 70, 0, 70)
		slotData.Frame.BackgroundColor3 = diceColors[finalColorName]
		slotData.Label.Text = finalColorName
		
		local tweenInfo = TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
		local tween = TweenService:Create(slotData.Frame, tweenInfo, {Size = UDim2.new(0, 60, 0, 60)})
		tween:Play()
		
		task.wait(0.3)
	end
	
	isRolling = false
end)

-- Sistema de Escalado Proporcional
local currentScale = 1

local function updateScale(delta)
	currentScale = math.clamp(currentScale + delta, 0.5, 1.5)
	percentLabel.Text = math.round(currentScale * 100) .. "%"
	uiScale.Scale = currentScale
end

plusSize.MouseButton1Click:Connect(function()
	updateScale(0.1)
end)

minusSize.MouseButton1Click:Connect(function()
	updateScale(-0.1)
end)

-- Funcionalidad de Minimizar / Maximizar
local isMinimized = false
minBtn.MouseButton1Click:Connect(function()
	isMinimized = not isMinimized
	if isMinimized then
		contentFrame.Visible = false
		mainFrame.Size = UDim2.new(0, 600, 0, 65)
		minBtn.Text = "+"
	else
		contentFrame.Visible = true
		mainFrame.Size = UDim2.new(0, 600, 0, 350)
		minBtn.Text = "-"
	end
end)

-- Mecánica para Mover la Ventana (Arrastrar)
local dragging, dragInput, dragStart, startPos

local function update(input)
	local delta = input.Position - dragStart
	mainFrame.Position = UDim2.new(
		startPos.X.Scale,
		startPos.X.Offset + delta.X,
		startPos.Y.Scale,
		startPos.Y.Offset + delta.Y
	)
end

mainFrame.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = mainFrame.Position
		
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

mainFrame.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		dragInput = input
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if input == dragInput and dragging then
		update(input)
	end
end)
